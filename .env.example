# VoyageAI Environment Variables
# Copy this file to .env for local testing or configure these in the Vercel Dashboard Settings -> Environment Variables.

# Optional: Google Gemini API Key for live AI itinerary generation & Copilot
# Get your key at: https://aistudio.google.com/
# Note: If left unset, VoyageAI seamlessly uses its high-fidelity built-in travel intelligence database.
GEMINI_API_KEY=

# Optional: Port for local Node.js server (defaults to 3000)
PORT=3000
